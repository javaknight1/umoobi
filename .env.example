# Copy to .env.local. `pnpm env:local` fills the Supabase values from `supabase status`.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker / cron (any long random string locally)
CRON_SECRET=

# Email (Resend). Without a key, emails are printed to the server console (D49).
RESEND_API_KEY=
EMAIL_FROM="Umoobi <hello@umoobi.com>"

# Stripe (test mode). Without keys, the dev payments provider is used (D49).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mux. Without keys, the dev video provider plays a public test stream (D49).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_DRM_ENABLED=false

# Content and rights checks
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
TMDB_API_KEY=

# Feature flags
FOUNDING_OFFER=false
MUX_DRM_CONFIGURATION_ID=
